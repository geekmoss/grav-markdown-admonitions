{
  "name": "grav-plugin/markdown-admonitions",
  "type": "grav-plugin",
  "description": "Markdown admonition blocks for Grav 2.",
  "keywords": ["grav", "plugin", "markdown", "admonition", "callout"],
  "homepage": "https://github.com/geekmoss/grav-markdown-admonitions",
  "license": "MIT",
  "authors": [{"name": "Geekmoss"}],
  "require": {"php": "^8.3"},
  "require-dev": {"phpunit/phpunit": "^11.0"},
  "autoload": {"psr-4": {"Grav\\Plugin\\Admonitions\\": "classes/"}},
  "extra": {"installer-name": "markdown-admonitions"},
  "minimum-stability": "stable",
  "prefer-stable": true,
  "scripts": {"test": "@php vendor/bin/phpunit"}
}
